# Coolify production environment for HealthLog
# Domain: https://hard-healthlog.bombeck.io

NODE_ENV=production

# Public/base URL (set both to the same HTTPS domain)
NEXT_PUBLIC_APP_URL=https://hard-healthlog.bombeck.io
APP_URL=https://hard-healthlog.bombeck.io

# Postgres from Coolify DB service
DATABASE_URL=postgresql://healthlog:<DB_PASSWORD>@<DB_HOST>:5432/healthlog?schema=public

# Required secrets (64 hex chars each)
SESSION_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
ENCRYPTION_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# Optional but recommended webhook secrets
WITHINGS_WEBHOOK_SECRET=<RANDOM_SECRET>
TELEGRAM_WEBHOOK_SECRET=<RANDOM_SECRET>

# Optional Withings app credentials
# WITHINGS_CLIENT_ID=<WITHINGS_CLIENT_ID>
# WITHINGS_CLIENT_SECRET=<WITHINGS_CLIENT_SECRET>
# WITHINGS_REDIRECT_URI=https://hard-healthlog.bombeck.io/api/withings/callback
