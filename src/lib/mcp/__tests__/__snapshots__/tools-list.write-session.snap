            "count",
            "firstDate",
            "lastDate",
            "reachableWithWindow"
          ],
          "additionalProperties": false
        },
        "data": {
          "type": "object",
          "properties": {
            "window": {
              "type": "string",
              "enum": [
                "last7days",
                "last30days",
                "last90days",
                "lastYear",
                "allTime"
              ]
            },
