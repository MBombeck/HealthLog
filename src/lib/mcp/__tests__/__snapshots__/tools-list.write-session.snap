            "type": "object",
            "properties": {
              "startMinute": {
                "type": "number"
              },
              "mean": {
                "type": "number"
              },
              "count": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "startMinute",
              "mean",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "baseline": {
