  {
    "name": "get_correlation",
    "title": "Get a correlation between two metrics",
    "description": "Fetch the statistically-vetted (FDR-controlled), lag-aware association between TWO named metrics the user tracks (e.g. 'sleep' and 'resting heart rate'). Re-exports the same discovery engine the other correlation surfaces run; returns the matched pair's direction, lag, sample size, Pearson r, and a descriptive — never causal — note. Returns { present: false } when no significant pattern links the pair (sparse data or the link did not clear the engine's floors).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "metricA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "metricB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "metricA",
        "metricB"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "pair": {
          "type": "object",
          "properties": {
            "behaviour": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            },
            "direction": {
              "type": "string",
              "enum": [
                "higher",
                "lower"
              ]
            },
            "lagDays": {
              "type": "number"
            },
            "n": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "behaviour",
            "outcome",
            "direction",
            "lagDays",
            "n",
            "r",
            "note"
          ],
          "additionalProperties": false
        },
        "pairsTested": {
          "type": "number"
        },
        "windowDays": {
          "type": "number"
        },
        "association": {
          "type": "string",
          "const": "descriptive"
        }
      },
      "required": [
        "present"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "compare_metric",
    "title": "Compare metrics or windows",
    "description": "Compare one metric against another over the same horizon, OR a single metric across two horizons. A horizon is either one of the five fixed trailing windows OR an explicit {from,to} date range (use `range`/`rangeB` for before-vs-after-a-date). Also resolves the clinical-signal metrics (grip strength, pain 0–10 NRS, waist circumference, waist-to-height ratio). A metric can be named by its alias, its key, or its display name in any language HealthLog ships (e.g. 'poids', 'Blutzucker'). Returns each side's rollup statistics (count, mean, min, max) with units and reference bands, plus a delta + percent change when both sides share a unit. Returns { present: false } when a side has no data.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "metricB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "window": {
          "type": "string",
          "enum": [
            "last7days",
            "last30days",
            "last90days",
            "lastYear",
            "allTime"
          ]
        },
        "windowB": {
          "type": "string",
          "enum": [
            "last7days",
            "last30days",
            "last90days",
            "lastYear",
            "allTime"
          ]
        },
        "range": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "to": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "description": "An explicit inclusive date range. Use INSTEAD OF `window` for an arbitrary span (e.g. before vs after a date). Both bounds are ISO-8601 instants."
        },
        "rangeB": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "to": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "description": "An explicit inclusive date range. Use INSTEAD OF `window` for an arbitrary span (e.g. before vs after a date). Both bounds are ISO-8601 instants."
        }
      },
      "required": [
        "metric"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "metric_vs_metric",
            "window_vs_window"
          ]
        },
        "a": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "band": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "low": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "low",
                    "high"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "windowDays": {
              "type": "number"
            },
            "granularity": {
              "type": "string"
            },
            "count": {
              "type": "number"
            },
            "mean": {
              "type": [
                "number",
                "null"
              ]
            },
            "min": {
              "type": [
                "number",
                "null"
              ]
            },
            "max": {
              "type": [
                "number",
                "null"
              ]
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "unit",
            "windowDays",
            "granularity",
            "count",
            "mean",
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "b": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "band": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "low": {
                      "type": "number"
