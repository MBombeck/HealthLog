  {
    "name": "get_labs",
    "title": "Get lab results",
    "description": "Fetch the user's lab results. By default returns the latest reading per biomarker over the whole record. Filtered to one named analyte, each matching marker also carries a summarised history (the newest earlier values in full, older ones as one mean / min / max / count per year). Pass history:true with an analyte to return that analyte's reading TRAJECTORY (newest first, paginated). Each reading carries its value, unit, reference range, and in-range/below/above status. Returns { present: false } when no labs match, and { present: false, reason: \"module_disabled\" } when the labs module is switched off.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "analyte": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "history": {
          "description": "When true (requires `analyte`), return that analyte's full reading trajectory (newest first, paginated) instead of the latest-per-biomarker snapshot.",
          "type": "boolean"
        },
        "cursor": {
          "description": "Opaque pagination cursor from a previous history response's nextCursor. Treat as a black box.",
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "data": {},
        "grounding": {
          "type": "string"
        },
        "searchedWindow": {
          "type": "string"
        },
        "available": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number"
            },
            "firstDate": {
              "type": "string"
            },
            "lastDate": {
              "type": "string"
            },
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "series": {
                    "type": "string"
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "count": {
                    "type": "number"
                  },
                  "mean": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": [
                  "series",
                  "unit",
                  "count",
                  "mean",
                  "min",
                  "max"
                ],
                "additionalProperties": false
              }
            },
            "reachableWithWindow": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "count",
            "firstDate",
            "lastDate",
            "reachableWithWindow"
          ],
          "additionalProperties": false
        },
        "analyte": {
          "type": "string"
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "valueText": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "referenceLow": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "referenceHigh": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rangeStatus": {
                "type": "string",
                "enum": [
                  "in-range",
                  "below",
                  "above",
                  "unknown"
                ]
              },
              "takenAt": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "valueText",
              "unit",
              "referenceLow",
              "referenceHigh",
              "rangeStatus",
              "takenAt"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "type": "string"
        }
      },
      "required": [
        "present"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
