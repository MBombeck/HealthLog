  {
    "name": "get_medication_compliance",
    "title": "Get medication compliance",
    "description": "Fetch the user's cadence-aware medication adherence: the dose-weighted compliance rate, expected vs taken/missed counts, current-cycle status, and any GLP-1 titration context. Returns { present: false } when no medications are tracked, and { present: false, reason: \"module_disabled\" } when the medications module is switched off.",
    "inputSchema": {
      "type": "object",
      "properties": {
