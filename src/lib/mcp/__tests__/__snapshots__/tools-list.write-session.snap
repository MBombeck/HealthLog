  {
    "name": "get_metrics",
    "title": "Get several metric series at once",
    "description": "Fetch the time series for SEVERAL metrics in one call — a fan-out over the same single-metric read `get_metric_series` runs, returning one grounded result per metric (each with { present } and the metric's aggregate/timelines when present). Paginated: when more metrics remain than fit one page, pass the opaque nextCursor back as `cursor`. Use for a multi-metric question instead of many separate calls.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "metrics": {
          "minItems": 1,
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": "The metrics to fetch (e.g. ['weight','pulse','hrv']). Unknown metrics return { present: false } for that entry, never an error."
        },
        "window": {
          "type": "string",
          "enum": [
            "last7days",
            "last30days",
            "last90days",
            "lastYear",
            "allTime"
          ]
        },
        "cursor": {
          "description": "Opaque pagination cursor from a previous response's nextCursor. Treat as a black box.",
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "metrics"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "window": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string"
              },
              "present": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "data": {},
              "grounding": {
                "type": "string"
              }
            },
            "required": [
              "metric",
              "present"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "type": "string"
        }
      },
      "required": [
        "present"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
