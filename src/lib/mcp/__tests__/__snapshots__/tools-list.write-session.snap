  {
    "name": "get_integration_status",
    "title": "Get device & service sync status",
    "description": "Fetch the sync health of the user's connected devices and services (Withings, WHOOP, Fitbit, Nightscout, Polar, Oura, Strava, Google Health) — which are connected, when each last synced, and whether one needs reconnecting or is failing. Answers 'why is my data stale?'. Reuses the integration-status ledger; carries no secrets or tokens. `connected` means only 'not explicitly disconnected'; `verdict` is the liveness truth (fresh / stale / stalled / failing / reauth_required / parked / pending_first_sync / disconnected), where `stalled` means the sync has stopped even attempting. Returns { present: false } when no integration has ever attempted a sync.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "connected": {
                "type": "boolean"
              },
              "reauthRequired": {
                "type": "boolean"
              },
              "lastSuccessAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lastAttemptAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verdict": {
                "type": "string"
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "provider",
              "state",
              "connected",
              "reauthRequired",
              "lastSuccessAt",
              "lastAttemptAt",
              "verdict",
              "since"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "present"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
