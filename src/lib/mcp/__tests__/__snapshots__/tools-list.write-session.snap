  {
    "name": "get_metric_baseline",
    "title": "Get a metric's personal baseline",
    "description": "Fetch where the user's latest reading for ONE metric sits against their own usual range (median ± robust deviation), plus the strongest lagged driver of that metric. Re-exports the same baseline engine the metric page renders. Also resolves the clinical-signal metrics (grip strength, pain 0–10 NRS, waist circumference, waist-to-height ratio). A metric can be named by its alias, its key, or its display name in any language HealthLog ships (e.g. 'poids', 'Blutzucker'). Returns the personal band, the latest value with its date and whether it is from today (latestDate, latestIsToday) + placement (within/above/below), and the population reference band. Returns { present: false } with reason 'insufficient_history' below the 7-day learning floor — never a fabricated range.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "metric"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "baseline": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "sampleDays": {
              "type": "number"
            }
          },
          "required": [
            "low",
            "high",
            "sampleDays"
          ],
          "additionalProperties": false
        },
        "latest": {
          "type": "number"
        },
        "latestDate": {
          "description": "Calendar day of `latest` in the user's time zone, `YYYY-MM-DD`.",
          "type": "string"
        },
        "latestIsToday": {
          "description": "True when `latest` is from today. When false, `latest` is an older reading: name its date, never call it today's.",
          "type": "boolean"
        },
        "placement": {
          "type": "string",
          "enum": [
            "within",
            "above",
            "below"
          ]
        },
        "basis": {
          "description": "Present when today is still in progress for a metric whose day mean moves with the hour (blood glucose): `latest` is today's mean so far and `baseline` the usual range for the same hours of earlier days, not the whole-day range.",
          "type": "string",
          "const": "sameHours"
        },
        "referenceBand": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                }
              },
              "required": [
                "low",
                "high"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "driver": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "note": {
                  "type": "string"
                },
                "behaviour": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string"
                }
              },
              "required": [
                "note",
                "behaviour",
                "outcome"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "present"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
