{
  "status": 307,
  "location": "http://localhost:3000/",
  "setCookies": [
    "oidc_auth_state=; Path=/api/auth/oidc; Expires=<date>"
  ],
  "events": [
    {
      "status": 307,
      "action": {
        "name": "auth.oidc.callback"
      },
      "meta": null,
      "warnings": null,
      "error": null
    }
  ],
  "effects": [
    {
      "effect": "recordSignInDevice",
      "args": [
        {
          "userId": "<id:1>",
          "ip": "unknown",
          "userAgent": null
        }
      ]
    }
  ],
  "stored": {
    "users": [
      {
        "username": "First",
        "email": "first@example.test",
        "role": "ADMIN",
        "timezone": "Europe/Berlin",
        "oidcIssuer": "https://id.example.test",
        "oidcSub": "sub-first"
      },
      {
        "username": "second",
        "email": "second@example.test",
        "role": "USER",
        "timezone": "Europe/Berlin",
        "oidcIssuer": "https://id.example.test",
        "oidcSub": "sub-second"
      }
    ],
    "sessions": [
      {
        "user": {
          "username": "First"
        },
        "mfaVerifiedAt": null
      },
      {
        "user": {
          "username": "second"
        },
        "mfaVerifiedAt": null
      }
    ],
    "audit": [
      {
        "action": "auth.oidc.login",
        "user": {
          "username": "First"
        }
      },
      {
        "action": "auth.oidc.login",
        "user": {
          "username": "second"
        }
      },
      {
        "action": "auth.oidc.provisioned",
        "user": {
          "username": "First"
        }
      },
      {
        "action": "auth.oidc.provisioned",
        "user": {
          "username": "second"
        }
      }
    ],
    "challenges": 0,
    "handoffs": 0
  }
}
